# Copy to .env and fill in. Never commit .env.

# --- JEV (TypeSafe System One): every cheap, structured decision ------
JEV_API_KEY=
# Pin a version so receipts are reproducible (jev-latest also works).
JEV_MODEL=jev-1.13.0
# Optional. Defaults to https://api.typesafe.ai
JEV_BASE_URL=

# --- OpenAI: only for generating reproduction tests ------------------
OPENAI_API_KEY=
LINUS_OPENAI_MODEL=gpt-5.4-mini
LINUS_OPENAI_REASONING=low

# --- neatlogs (tracing, required for the hackathon) ------------------
NEATLOGS_API_KEY=
NEATLOGS_WORKFLOW_NAME=linus
# Only set this for EU projects: https://eu.ingest.neatlogs.com
NEATLOGS_ENDPOINT=

# --- GitHub (optional) -----------------------------------------------
# Only needed with --github, `linus demo --publish` and `linus doctor`.
# `linus close --github OWNER/REPO` only reads: a read-only token is enough
# (contents, pull requests, issues), or none for public repos within the
# anonymous rate limit.
# `linus demo --publish` and `linus close --comment` write: they need `repo`
# scope (classic token), or a fine-grained token with read and write access
# to administration (to create the repo), contents, issues and pull requests.
# Branches are pushed with your own git credentials, not this token.
GITHUB_TOKEN=
# owner/name of a repo for `linus doctor` to check
LINUS_TARGET_REPO=

# --- Runtime ----------------------------------------------------------
LINUS_STATE_DIR=.linus
